From f1c1b71c1e5ad716c771b72aa37257b846b6fd85 Mon Sep 17 00:00:00 2001
From: Hecheng Yu <kde-yyds@qq.com>
Date: Sat, 1 Aug 2026 14:13:45 +0800
Subject: [PATCH 5/8] dodge: Clamp 720p video to 30fps to fix freeze after
 using 4K120

Same stale-fps problem as the 8K fix, but for 720p. 720p is the smallest
resolution on the rear main camera and, like 8K, only supports 30fps. Once
120fps is selected at 1080p/4K the app's fps state stays 120 when switching
---
 smali_classes12/ck/u0.smali | 26 ++++++++++++++++++++++++++
 smali_classes29/la/e.smali  | 15 +++++++++++++++
 2 files changed, 41 insertions(+)

diff --git a/smali_classes12/ck/u0.smali b/smali_classes12/ck/u0.smali
index 74f54188..dc91fa21 100644
--- a/smali_classes12/ck/u0.smali
+++ b/smali_classes12/ck/u0.smali
@@ -618,6 +618,16 @@
 .method public final A(II)V
     .locals 2
 
+    const/16 v0, 0x500
+
+    if-ne p1, v0, :cond_a12_720_done
+
+    const/16 v0, 0x1e
+
+    invoke-virtual {p0, v0}, Lck/u0;->y(I)V
+
+    :cond_a12_720_done
+
     const/16 v0, 0x1e00
 
     if-lt p1, v0, :cond_a12_8k
@@ -6879,6 +6889,22 @@
 
     iget v0, p1, Landroid/media/CamcorderProfile;->videoFrameWidth:I
 
+    const/16 v1, 0x500
+
+    if-ne v0, v1, :cond_a12_profile_720_done
+
+    iget v0, p1, Landroid/media/CamcorderProfile;->videoFrameRate:I
+
+    const/16 v1, 0x1e
+
+    if-le v0, v1, :cond_a12_profile_720_done
+
+    iput v1, p1, Landroid/media/CamcorderProfile;->videoFrameRate:I
+
+    :cond_a12_profile_720_done
+
+    iget v0, p1, Landroid/media/CamcorderProfile;->videoFrameWidth:I
+
     const/16 v1, 0x1e00
 
     if-lt v0, v1, :cond_a12_profile_done
diff --git a/smali_classes29/la/e.smali b/smali_classes29/la/e.smali
index 9cd68c04..fd9e7766 100644
--- a/smali_classes29/la/e.smali
+++ b/smali_classes29/la/e.smali
@@ -1881,6 +1881,21 @@
 
     move-result-object v14
 
+    const-string v1, "video_size_720p"
+
+    invoke-virtual {v1, v14}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v14
+
+    if-eqz v14, :cond_a12_fps_8k_check
+
+    const-string v12, "video_30fps"
+
+    :cond_a12_fps_8k_check
+    invoke-virtual/range {p0 .. p0}, Lla/e;->p1()Ljava/lang/String;
+
+    move-result-object v14
+
     const-string v1, "video_size_8k"
 
     invoke-virtual {v1, v14}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
-- 
